flowchart TB
  STS["Enterprise STS + MFA<br/>Proves who, issues token"]
  APP["Applications<br/>Present token, no auth logic"]
  TYK["Tyk Gateway (OSS)<br/>Validates STS token, JWT and OIDC<br/>AuthZEN PEP, deny-overrides composition"]
  ENTENT["ICAM entitlements<br/>Clearances, envelopes<br/>Approved by ICAM"]
  EPDP["Enterprise PDP<br/>Policy floor<br/>Evaluated first"]
  MPDP["Edge PDP (Cerbos)<br/>Case, role, step-up<br/>Restricts only"]
  MENT["Mission entitlements<br/>Case and role grants<br/>Approved by stewards"]
  DEC["Composed decision<br/>Permit only if both permit, step-up via STS"]

  STS -->|signed token| APP
  APP --> TYK
  TYK -->|AuthZEN| EPDP
  TYK -->|AuthZEN| MPDP
  ENTENT --> EPDP
  MENT -->|attribute lookup| TYK
  EPDP --> DEC
  MPDP --> DEC

  classDef enterprise fill:#E6F1FB,stroke:#185FA5,color:#0C447C
  classDef platform fill:#EEEDFE,stroke:#534AB7,color:#3C3489,stroke-width:2px
  classDef mission fill:#E1F5EE,stroke:#0F6E56,color:#085041
  classDef neutral fill:#F1EFE8,stroke:#5F5E5A,color:#444441

  class STS,ENTENT,EPDP enterprise
  class TYK platform
  class MPDP,MENT mission
  class APP,DEC neutral
